+@Composable
+private fun GpuDriverCard(
+    drivers: List<GpuDriver>, selected: String, gpuHw: String, message: String?,
+    onImport: () -> Unit, onSelect: (String) -> Unit, onDelete: (GpuDriver) -> Unit
