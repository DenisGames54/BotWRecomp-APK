diff --git a/native/CMakeLists.txt b/native/CMakeLists.txt
index fa7c8cf..1e9103a 100644
--- a/native/CMakeLists.txt
+++ b/native/CMakeLists.txt
@@ -21,7 +21,10 @@ set(ROOT "${APKROOT}/engine" CACHE PATH "BotWRecomp-Android engine checkout (sub
 set(BOTW_DEPS "${APKROOT}/deps" CACHE PATH "third-party sources (scripts/fetch_deps.sh)")
 set(BOTW_GENERATED "${APKROOT}/work/generated" CACHE PATH "recompiled guest code (from YOUR dump)")
 set(BOTW_JNILIBS "${APKROOT}/app/src/main/jniLibs/arm64-v8a" CACHE PATH "where libmain.so / libSDL3.so are copied")
-set(BOTW_CPU "cortex-a710" CACHE STRING "-mcpu for generated code")
+# NOTE: do NOT use cortex-a710 here. That target enables SVE/SVE2, which the Snapdragon 7+ Gen 2 (POCO F5) kernel
+# does not expose (no "sve" in /proc/cpuinfo), so the compiler emits instructions (rdvl, ptrue, ...) that raise
+# SIGILL. cortex-a78 is Armv8.2-A without SVE and runs on every core of this SoC.
+set(BOTW_CPU "cortex-a78" CACHE STRING "-mcpu for generated code (must not enable SVE on devices without it)")
 set(BOTW_PGO "" CACHE STRING "PGO mode: gen | use")
 set(BOTW_PGO_DATA "" CACHE FILEPATH "merged .profdata (BOTW_PGO=use)")
 
diff --git a/scripts/build_native.sh b/scripts/build_native.sh
index b7c5198..cee9e0f 100755
--- a/scripts/build_native.sh
+++ b/scripts/build_native.sh
@@ -1,6 +1,6 @@
 #!/usr/bin/env bash
 # Builds libmain.so + libSDL3.so with the NDK and copies them into app/src/main/jniLibs/arm64-v8a.
-# Env: JOBS (default 3; the generated guest code is memory hungry), BOTW_CPU, BOTW_PGO=gen|use + BOTW_PGO_DATA
+# Env: JOBS (default 3; the generated guest code is memory hungry), BOTW_CPU (default cortex-a78: no SVE), BOTW_PGO=gen|use + BOTW_PGO_DATA
 set -euo pipefail
 ROOT="$(cd "$(dirname "$0")/.." && pwd)"
 source "$ROOT/.botw-apk-env"
@@ -8,6 +8,6 @@ cmake -S "$ROOT/native" -B "$ROOT/build/native" -G Ninja \
   -DCMAKE_TOOLCHAIN_FILE="$ANDROID_NDK_HOME/build/cmake/android.toolchain.cmake" \
   -DANDROID_ABI=arm64-v8a -DANDROID_PLATFORM=android-29 -DANDROID_STL=c++_static \
   -DCMAKE_BUILD_TYPE=Release \
-  ${BOTW_CPU:+-DBOTW_CPU=$BOTW_CPU} ${BOTW_PGO:+-DBOTW_PGO=$BOTW_PGO} ${BOTW_PGO_DATA:+-DBOTW_PGO_DATA=$BOTW_PGO_DATA}
+  -DBOTW_CPU="${BOTW_CPU:-cortex-a78}" ${BOTW_PGO:+-DBOTW_PGO=$BOTW_PGO} ${BOTW_PGO_DATA:+-DBOTW_PGO_DATA=$BOTW_PGO_DATA}
 ninja -C "$ROOT/build/native" -j"${JOBS:-3}" main
 ls -lh "$ROOT/app/src/main/jniLibs/arm64-v8a/"
